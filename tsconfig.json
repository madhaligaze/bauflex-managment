{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Подключаем типы Vite и Node */
    "types": ["node", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    /* Обязательно для References */
    "composite": true,
    "allowJs": true,
    "esModuleInterop": true,

    /* Linting (Смягченные настройки) */
    "strict": true,
    "noUnusedLocals": false,       /* Теперь не будет ругаться на забытые переменные */
    "noUnusedParameters": false,   /* И на неиспользуемые аргументы функций */
    "noFallthroughCasesInSwitch": true,

    /* Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "server.ts"], 
  "references": [{ "path": "./tsconfig.node.json" }]
}