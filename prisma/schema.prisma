generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("User")
}

model Employee {
  id              Int       @id @default(autoincrement())
  name            String
  position        String?
  email           String?
  phone           String?
  department      String?
  
  // Новые поля для размеров
  clothingSize    String?   @map("clothing_size")
  shoeSize        String?   @map("shoe_size")
  height          String?
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  Request         Request[]

  @@map("Employee")
}

model Request {
  id              Int       @id @default(autoincrement())
  requestNumber   String    @unique @map("request_number")
  
  // Связь с сотрудником теперь опциональная
  employee        Employee? @relation(fields: [employeeId], references: [id])
  employeeId      Int?      @map("employee_id")
  
  // Добавляем поле для хранения имени если сотрудник не из базы
  employeeName    String?   @map("employee_name")
  
  itemName        String    @map("item_name")
  quantity        Int
  unit            String
  urgency         String
  purpose         String?
  notes           String?
  status          String    @default("pending")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("Request")
}

enum Role {
  USER
  ADMIN
}
