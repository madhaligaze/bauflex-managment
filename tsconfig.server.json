{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "routes/**/*.ts",
    "entities/**/*.ts",
    "shared/lib/**/*.ts"
  ],
  "exclude": ["node_modules", "src"]
}